    {
      "path": "system_map.html",
      "mimeType": "text/html",
      "title": "system_map.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Roboto+Mono&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { \n      width: 1280px; min-height: 720px; \n      background: #050A0E; color: #E2F1F8;\n      font-family: 'Roboto Mono', monospace;\n      display: flex; flex-direction: column;\n      padding: 40px;\n    }\n    .motif { \n      position: absolute; top: 40px; right: 40px;\n      color: #8AF8FF; font-family: 'Share Tech Mono', monospace;\n      font-size: 14px; letter-spacing: 2px;\n    }\n    header { margin-bottom: 40px; border-bottom: 1px solid #1E3A5F; padding-bottom: 20px; }\n    h2 { font-family: 'Share Tech Mono', monospace; font-size: 32px; color: #8AF8FF; text-transform: uppercase; }\n    \n    .diagram-container { flex: 1; display: flex; align-items: center; justify-content: center; }\n    .map-grid { display: grid; grid-template-columns: repeat(4, 240px); gap: 40px; align-items: center; justify-content: center; position: relative; }\n    \n    .node {\n      border: 1px solid #1E3A5F;\n      padding: 20px;\n      text-align: center;\n      position: relative;\n      background: #0F171E;\n    }\n    .node::before {\n      content: ''; position: absolute; top: -1px; left: -1px; width: 10px; height: 10px;\n      border-top: 2px solid #8AF8FF; border-left: 2px solid #8AF8FF;\n    }\n    .node-title { font-family: 'Share Tech Mono', monospace; font-size: 18px; color: #8AF8FF; margin-bottom: 8px; }\n    .node-desc { font-size: 12px; color: #6B8A9C; }\n    \n    .connector { position: absolute; height: 2px; background: #1E3A5F; z-index: -1; }\n    \n    .page-num { position: absolute; bottom: 40px; right: 40px; font-family: 'Share Tech Mono', monospace; color: #6B8A9C; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif\">[ AEGIS v3.2 // SYS.OP.ACTIVE ]</div>\n    <header>\n      <h2>System Map</h2>\n    </header>\n    <div class=\"diagram-container\">\n      <div class=\"map-grid\">\n        <div class=\"node\">\n          <div class=\"node-title\">BROWSER UI</div>\n          <div class=\"node-desc\">React 18 / Vite 5<br>Tailwind CSS 3</div>\n        </div>\n        <div class=\"node\">\n          <div class=\"node-title\">SHELL LAYER</div>\n          <div class=\"node-desc\">BrowserRouter<br>HUD Navigation</div>\n        </div>\n        <div class=\"node\">\n          <div class=\"node-title\">MAP CORE</div>\n          <div class=\"node-desc\">MapLibre GL<br>Globe Projection</div>\n        </div>\n        <div class=\"node\">\n          <div class=\"node-title\">DATA SOURCE</div>\n          <div class=\"node-desc\">ADS-B / USGS<br>Public OSINT</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"page-num\">[ 02 / 07 ]</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "runtime_shell.html",
      "mimeType": "text/html",
      "title": "runtime_shell.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Roboto+Mono&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { \n      width: 1280px; min-height: 720px; \n      background: #050A0E; color: #E2F1F8;\n      font-family: 'Roboto Mono', monospace;\n      display: flex; flex-direction: column;\n      padding: 40px;\n    }\n    .motif { \n      position: absolute; top: 40px; right: 40px;\n      color: #8AF8FF; font-family: 'Share Tech Mono', monospace;\n      font-size: 14px; letter-spacing: 2px;\n    }\n    header { margin-bottom: 40px; border-bottom: 1px solid #1E3A5F; padding-bottom: 20px; }\n    h2 { font-family: 'Share Tech Mono', monospace; font-size: 32px; color: #8AF8FF; text-transform: uppercase; }\n    \n    .content-split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px; flex: 1; }\n    .shell-details { display: flex; flex-direction: column; gap: 24px; }\n    .detail-item { border-left: 2px solid #8AF8FF; padding-left: 20px; }\n    .detail-title { font-family: 'Share Tech Mono', monospace; color: #8AF8FF; margin-bottom: 8px; font-size: 20px; }\n    .detail-text { color: #6B8A9C; font-size: 16px; line-height: 1.6; }\n    \n    table { width: 100%; border-collapse: collapse; font-family: 'Share Tech Mono', monospace; font-size: 16px; }\n    th { text-align: left; padding: 12px; border-bottom: 1px solid #1E3A5F; color: #6B8A9C; text-transform: uppercase; }\n    td { padding: 12px; border-bottom: 1px solid #1E3A5F; color: #E2F1F8; }\n    .route-path { color: #8AF8FF; }\n    \n    .page-num { position: absolute; bottom: 40px; right: 40px; font-family: 'Share Tech Mono', monospace; color: #6B8A9C; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif\">[ AEGIS v3.2 // SYS.OP.ACTIVE ]</div>\n    <header>\n      <h2>Runtime Shell & Routing</h2>\n    </header>\n    <div class=\"content-split\">\n      <div class=\"shell-details\">\n        <div class=\"detail-item\">\n          <div class=\"detail-title\">SPA FRAMEWORK</div>\n          <div class=\"detail-text\">Single-page application powered by React and react-router-dom v6 for instant, sub-millisecond view switching.</div>\n        </div>\n        <div class=\"detail-item\">\n          <div class=\"detail-title\">PERSISTENT UI</div>\n          <div class=\"detail-text\">Static Sidebar navigation and TopBar header maintain global system context across all route changes.</div>\n        </div>\n        <div class=\"detail-item\">\n          <div class=\"detail-title\">ERROR HANDLING</div>\n          <div class=\"detail-text\">Catch-all wildcard routing ensures invalid URLs trigger a themed HUD fallback instead of broken 404 pages.</div>\n        </div>\n      </div>\n      <div>\n        <table>\n          <thead>\n            <tr><th>ROUTE</th><th>MODULE</th><th>STATUS</th></tr>\n          </thead>\n          <tbody>\n            <tr><td class=\"route-path\">/</td><td>DASHBOARD</td><td>NOMINAL</td></tr>\n            <tr><td class=\"route-path\">/world</td><td>WORLD VIEW</td><td>LIVE</td></tr>\n            <tr><td class=\"route-path\">/weather</td><td>WEATHER INTEL</td><td>LIVE</td></tr>\n            <tr><td class=\"route-path\">/feeds</td><td>CONFLICT FEED</td><td>SYNCING</td></tr>\n            <tr><td class=\"route-path\">/social</td><td>SOCIAL HUB</td><td>STANDBY</td></tr>\n            <tr><td class=\"route-path\">/scopes</td><td>RADAR ARRAY</td><td>ACTIVE</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n    <div class=\"page-num\">[ 03 / 07 ]</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "world_pipeline.html",
      "mimeType": "text/html",
      "title": "world_pipeline.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Roboto+Mono&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { \n      width: 1280px; min-height: 720px; \n      background: #050A0E; color: #E2F1F8;\n      font-family: 'Roboto Mono', monospace;\n      display: flex; flex-direction: column;\n      padding: 40px;\n    }\n    .motif { \n      position: absolute; top: 40px; right: 40px;\n      color: #8AF8FF; font-family: 'Share Tech Mono', monospace;\n      font-size: 14px; letter-spacing: 2px;\n    }\n    header { margin-bottom: 40px; border-bottom: 1px solid #1E3A5F; padding-bottom: 20px; }\n    h2 { font-family: 'Share Tech Mono', monospace; font-size: 32px; color: #8AF8FF; text-transform: uppercase; }\n    \n    .pipeline { flex: 1; display: flex; flex-direction: column; gap: 30px; justify-content: center; }\n    .step { display: grid; grid-template-columns: 180px 40px 1fr; align-items: center; gap: 20px; }\n    .step-id { font-family: 'Share Tech Mono', monospace; font-size: 18px; color: #8AF8FF; border: 1px solid #1E3A5F; padding: 10px; text-align: center; }\n    .arrow { color: #1E3A5F; font-size: 24px; }\n    .step-content { border-left: 2px solid #1E3A5F; padding: 15px 30px; background: #0F171E; }\n    .step-title { font-family: 'Share Tech Mono', monospace; font-size: 20px; color: #8AF8FF; margin-bottom: 8px; }\n    .step-text { color: #6B8A9C; font-size: 15px; }\n    \n    .page-num { position: absolute; bottom: 40px; right: 40px; font-family: 'Share Tech Mono', monospace; color: #6B8A9C; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif\">[ AEGIS v3.2 // SYS.OP.ACTIVE ]</div>\n    <header>\n      <h2>WorldView Data Pipeline</h2>\n    </header>\n    <div class=\"pipeline\">\n      <div class=\"step\">\n        <div class=\"step-id\">INGESTION</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"step-content\">\n          <div class=\"step-title\">OSINT FEED POLLING</div>\n          <div class=\"step-text\">Asynchronous polling of public ADS-B (api.adsb.lol) and USGS earthquake GeoJSON feeds with custom retry logic and connection failover.</div>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-id\">TRANSFORM</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"step-content\">\n          <div class=\"step-title\">GEOJSON NORMALIZATION</div>\n          <div class=\"step-text\">Normalizing raw telemetry into standard FeatureCollections; implementing aircraft capping (max 300) and magnitude filtering.</div>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-id\">RENDER</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"step-content\">\n          <div class=\"step-title\">MAPLIBRE GL GLOBE</div>\n          <div class=\"step-text\">Hardware-accelerated 3D globe projection utilizing Carto Dark Matter styles and dynamic symbol rotation based on aircraft track vectors.</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"page-num\">[ 04 / 07 ]</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "telemetry.html",
      "mimeType": "text/html",
      "title": "telemetry.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Roboto+Mono&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { \n      width: 1280px; min-height: 720px; \n      background: #050A0E; color: #E2F1F8;\n      font-family: 'Roboto Mono', monospace;\n      display: flex; flex-direction: column;\n      padding: 40px;\n    }\n    .motif { \n      position: absolute; top: 40px; right: 40px;\n      color: #8AF8FF; font-family: 'Share Tech Mono', monospace;\n      font-size: 14px; letter-spacing: 2px;\n    }\n    header { margin-bottom: 40px; border-bottom: 1px solid #1E3A5F; padding-bottom: 20px; }\n    h2 { font-family: 'Share Tech Mono', monospace; font-size: 32px; color: #8AF8FF; text-transform: uppercase; }\n    \n    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-bottom: 60px; }\n    .stat-card { border: 1px solid #1E3A5F; padding: 30px; background: #0F171E; position: relative; }\n    .stat-label { font-family: 'Share Tech Mono', monospace; font-size: 14px; color: #6B8A9C; letter-spacing: 1px; margin-bottom: 15px; }\n    .stat-value { font-family: 'Share Tech Mono', monospace; font-size: 48px; color: #8AF8FF; text-shadow: 0 0 10px rgba(138,248,255,0.5); }\n    \n    .telemetry-logic { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; flex: 1; }\n    .logic-box { border-top: 1px solid #8AF8FF; padding-top: 20px; }\n    .logic-title { font-family: 'Share Tech Mono', monospace; font-size: 20px; color: #8AF8FF; margin-bottom: 15px; }\n    .logic-text { color: #6B8A9C; font-size: 16px; line-height: 1.6; }\n    \n    .page-num { position: absolute; bottom: 40px; right: 40px; font-family: 'Share Tech Mono', monospace; color: #6B8A9C; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif\">[ AEGIS v3.2 // SYS.OP.ACTIVE ]</div>\n    <header>\n      <h2>Live Diagnostics Telemetry</h2>\n    </header>\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-label\">STREAM STATUS</div>\n        <div class=\"stat-value\">CONNECTED</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-label\">CPU NODE LOAD</div>\n        <div class=\"stat-value\">43.2%</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-label\">JS HEAP UTIL</div>\n        <div class=\"stat-value\">28.4%</div>\n      </div>\n    </div>\n    <div class=\"telemetry-logic\">\n      <div class=\"logic-box\">\n        <div class=\"logic-title\">EVENTSOURCE STREAMING</div>\n        <div class=\"logic-text\">Real-time system health data is streamed via EventSource from /api/system/telemetry, delivering sub-second updates to the console.</div>\n      </div>\n      <div class=\"logic-box\">\n        <div class=\"logic-title\">ROBUST FALLBACK</div>\n        <div class=\"logic-text\">If the server stream is unavailable, the console utilizes the Browser Performance API to sample local heap and event-loop latency.</div>\n      </div>\n    </div>\n    <div class=\"page-num\">[ 05 / 07 ]</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "interaction_design.html",
      "mimeType": "text/html",
      "title": "interaction_design.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Roboto+Mono&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { \n      width: 1280px; min-height: 720px; \n      background: #050A0E; color: #E2F1F8;\n      font-family: 'Roboto Mono', monospace;\n      display: flex; flex-direction: column;\n      padding: 40px;\n    }\n    .motif { \n      position: absolute; top: 40px; right: 40px;\n      color: #8AF8FF; font-family: 'Share Tech Mono', monospace;\n      font-size: 14px; letter-spacing: 2px;\n    }\n    header { margin-bottom: 40px; border-bottom: 1px solid #1E3A5F; padding-bottom: 20px; }\n    h2 { font-family: 'Share Tech Mono', monospace; font-size: 32px; color: #8AF8FF; text-transform: uppercase; }\n    \n    .grid-ui { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; flex: 1; }\n    .ui-section { display: flex; flex-direction: column; gap: 20px; }\n    .ui-card { border: 1px solid #1E3A5F; padding: 25px; position: relative; }\n    .ui-card::before {\n      content: ''; position: absolute; top: -1px; left: -1px; width: 12px; height: 12px;\n      border-top: 2px solid #8AF8FF; border-left: 2px solid #8AF8FF;\n    }\n    .ui-card-title { font-family: 'Share Tech Mono', monospace; font-size: 18px; color: #8AF8FF; margin-bottom: 10px; }\n    .ui-list { list-style: none; }\n    .ui-list li { color: #6B8A9C; font-size: 15px; margin-bottom: 8px; position: relative; padding-left: 20px; }\n    .ui-list li::before { content: '>'; position: absolute; left: 0; color: #8AF8FF; }\n    \n    .page-num { position: absolute; bottom: 40px; right: 40px; font-family: 'Share Tech Mono', monospace; color: #6B8A9C; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"motif\">[ AEGIS v3.2 // SYS.OP.ACTIVE ]</div>\n    <header>\n      <h2>Interaction & HUD System</h2>\n    </header>\n    <div class=\"grid-ui\">\n      <div class=\"ui-section\">\n        <div class=\"ui-card\">\n          <div class=\"ui-card-title\">HUD PRIMITIVES</div>\n          <ul class=\"ui-list\">\n            <li>HudFrame: Animated corner brackets & scanlines</li>\n            <li>GaugeCircle: SVG-based hardware acceleration</li>\n            <li>StatusCard: Color-coded health telemetry</li>\n            <li>Radar: HTML5 Canvas 60fps sweep logic</li>\n          </ul>\n        </div>\n        <div class=\"ui-card\">\n          <div class=\"ui-card-title\">MOTION SYSTEM</div>\n          <ul class=\"ui-list\">\n            <li>Entry: translateY staggered route transitions</li>\n            <li>Hover: Border glow and bracket expansion</li>\n            <li>Feedback: Pulsing dots for system live-state</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"ui-section\">\n        <div class=\"ui-card\" style=\"flex: 1;\">\n          <div class=\"ui-card-title\">LIVE CONTROLS</div>\n          <div style=\"color: #6B8A9C; font-size: 15px; line-height: 1.6;\">\n            The WorldView interface provides immediate filtering of global public feeds:\n            <br><br>\n            - Toggle visibility of 300+ aircraft\n            <br>\n            - Real-time magnitude thresholding for quakes\n            <br>\n            - Interactive temp layers via Open-Meteo\n            <br><br>\n            Responsive layout ensures HUD overlays stack logically on constrained viewports while preserving map interactive surface.\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"page-num\">[ 06 / 07 ]</div>\n  </div>\n</body>\n</html>\n"
    },
    {
      "path": "delivery.html",
