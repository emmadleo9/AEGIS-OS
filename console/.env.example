VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-analytics-measurement-id
VITE_META_APP_ID=
VITE_FB_LOGIN_CONFIG_ID=

# Provider secrets belong in the repository root .env or gateway/.env.local.
# Do not prefix API secrets with VITE_ because Vite exposes those in browser bundles.
# These VITE_* placeholders are intentionally blank; real values must stay server-side.
VITE_NVIDIA_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_TAVILY_API_KEY=