# AEGIS-OS Environment Configuration
# Copy this file to .env and customize before running `docker compose up -d`

# =============================================================================
# CORE
# =============================================================================
APP_NAME=AEGIS-OS
ENV=production

# =============================================================================
# BRAIN (OpenJarvis) — port 8000
# =============================================================================
MODEL=qwen2.5:3b
OPENJARVIS_MODEL=qwen2.5:3b
OLLAMA_HOST=http://ollama:11434
WHATSAPP_VERIFY_TOKEN=aegis_verify_token
WHATSAPP_APP_SECRET=aegis_app_secret
OPENJARVIS_CORS_ORIGINS=http://console:3000,http://localhost:3000
LOG_LEVEL=info

# =============================================================================
# GATEWAY (OpenWA) — port 2785 — SQLite (not Postgres)
# =============================================================================
PORT=2785
API_PORT=2785
NODE_ENV=production
LOG_LEVEL=info
DATABASE_TYPE=sqlite
DATABASE_SYNCHRONIZE=false
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
WEBHOOK_URL=http://brain:8000/webhooks/whatsapp
API_MASTER_KEY=aegis_master_key
CORS_ORIGINS=http://console:3000,http://localhost:3000
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# =============================================================================
# CONSOLE (AEGIS) — port 3000
# =============================================================================
VITE_GATEWAY_URL=http://gateway:2785
VITE_BRAIN_URL=http://brain:8000
VITE_APP_NAME=AEGIS
NODE_ENV=production

# =============================================================================
# OLLAMA — local LLM
# =============================================================================
OLLAMA_HOST=0.0.0.0:11434

# =============================================================================
# DB (Postgres 15 for OpenBSP triggers)
# =============================================================================
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis_console

# =============================================================================
# REDIS
# =============================================================================
REDIS_ENABLED=false
