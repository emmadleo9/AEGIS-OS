# Krynara-OS Environment Configuration
# Copy this file to .env and customize before running `docker compose up -d`

# =============================================================================
# CORE
# =============================================================================
APP_NAME=Krynara-OS
ENV=production

# =============================================================================
# BRAIN (OpenJarvis) — port 8000
# =============================================================================
MODEL=meta/llama-3.2-3b-instruct
OPENJARVIS_MODEL=meta/llama-3.2-3b-instruct
OLLAMA_HOST=http://ollama:11434
WHATSAPP_VERIFY_TOKEN=krynara_verify_token
WHATSAPP_APP_SECRET=krynara_app_secret
KRYNARA_GATEWAY_URL=http://gateway:2785
KRYNARA_API_KEY=krynara_master_key
KRYNARA_SESSION_ID=krynara-whatsapp-session
OPENJARVIS_CORS_ORIGINS=http://console:3000,http://localhost:3000
LOG_LEVEL=info

# =============================================================================
# GATEWAY (OpenWA) — port 2785 — SQLite (not Postgres)
# =============================================================================
PORT=2785
API_PORT=2785
NODE_ENV=production
LOG_LEVEL=info
DATABASE_TYPE=sqlite
DATABASE_SYNCHRONIZE=false
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
WEBHOOK_URL=http://brain:8000/webhooks/whatsapp
API_MASTER_KEY=aa4b2b4142b6f0a9c0e8abbe00e0553b30db4157df72b419302ebe02182eb8f3
CORS_ORIGINS=http://console:3000,http://localhost:3000
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# =============================================================================
# CONSOLE (KRYNARA) — port 3000
# =============================================================================
VITE_GATEWAY_URL=http://gateway:2785
VITE_BRAIN_URL=http://brain:8000
VITE_APP_NAME=KRYNARA
NODE_ENV=production

# =============================================================================
# OLLAMA — local LLM
# =============================================================================
OLLAMA_HOST=0.0.0.0:11434

# =============================================================================
# DB (Postgres 15 for OpenBSP triggers)
# =============================================================================
POSTGRES_USER=krynara
POSTGRES_PASSWORD=krynara_password
POSTGRES_DB=krynara_console

# =============================================================================
# REDIS
# =============================================================================
REDIS_ENABLED=false

# =============================================================================
# CONSOLE ONLINE AI — optional; leave blank until you add your own keys
# =============================================================================
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=

# Optional browser placeholders only. Never put real provider secrets in VITE_* variables;
# Vite embeds them in client bundles. Keep actual provider keys above server-side.
VITE_NVIDIA_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_TAVILY_API_KEY=
